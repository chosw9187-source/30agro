// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EVALUATOR
  EMPLOYEE
}

enum ItemType {
  SCORE
  TEXT
  GRADE
}

enum TemplateKind {
  COMPETENCY
  PERFORMANCE
}

enum CycleStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EvaluationStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
}

enum NotificationType {
  SELF_ASSESSMENT_SUBMITTED
  COMMENT_ADDED
  ONBOARDING_BOOKING_REQUESTED
  ONBOARDING_BOOKING_DECIDED
  ONBOARDING_SCHEDULE_CHANGED
}

enum Position {
  CEO
  OPERATIONS_HEAD
  SENIOR_STAFF
  TEAM_LEADER
  STAFF
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String?  @unique
  employeeNumber String   @unique
  passwordHash   String
  mustChangePassword Boolean @default(true)
  role           Role
  position       Position @default(STAFF)
  birthDate       DateTime?
  hireDate        DateTime?
  terminationDate DateTime?
  employmentType  String?
  jobGrade        String?
  educationLevel  String?
  school          String?
  major           String?
  degree          String?
  jobFamily       String?
  gender          String?
  photo           Bytes?
  photoType       String?
  businessUnit    String?
  division        String?
  isKeyTalent     Boolean  @default(false)
  hiddenFromDirectory Boolean @default(false)
  teamId         String?
  team           Team?    @relation("TeamMember", fields: [teamId], references: [id])
  createdAt      DateTime @default(now())

  createdTemplates EvaluationTemplate[] @relation("TemplateCreator")
  evaluationsGiven Evaluation[]         @relation("Evaluator")
  evaluationsOwned Evaluation[]         @relation("Evaluatee")
  comments         Comment[]
  ledTeams         Team[]               @relation("TeamLeader")
  assignedItems    TemplateItem[]       @relation("AssignedItems")
  notifications    Notification[]       @relation("NotificationRecipient")
  targetYears      UserTargetYear[]
  appointmentRecords AppointmentRecord[]
  performanceHistory PerformanceHistory[]
  educationRecords EducationRecord[]
  careerHistory    CareerHistory[]
  certifications   Certification[]
  commendationDiscipline CommendationDiscipline[]
  permissionOverrides UserPermissionOverride[]
  tasksAssigned    Task[]         @relation("TaskAssignee")
  tasksCreated     Task[]         @relation("TaskCreator")
  sopDocuments     SopDocument[]
  workLogEntries   WorkLogEntry[]
  surveyInvitesCreated SurveyInviteLink[]
  competencyResponses CompetencyAssessmentResponse[]
  erpImportBatches ErpImportBatch[]
  pageViews        PageView[]
  onboardingPrograms    OnboardingProgram[]    @relation("OnboardingProgramCreator")
  uploadedRegulations   Regulation[]           @relation("RegulationUploader")
  onboardingSessionsAdded OnboardingSession[]  @relation("OnboardingSessionCreator")
  onboardingSessionsTaught OnboardingSession[] @relation("OnboardingSessionInstructor")
  onboardingTrainee       OnboardingTrainee[]  @relation("OnboardingTrainee")
  onboardingTraineesAdded OnboardingTrainee[]  @relation("OnboardingTraineeAdder")
}

model AppointmentRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  type          String?
  title         String?
  department    String?
  positionTitle String?
  jobGrade      String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([userId, date])
}

model PerformanceHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  grade     String?
  score     Float?
  note      String?
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
}

model EducationRecord {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level          String // 고등학교 | 대학교 | 대학원(석사) | 대학원(박사)
  school         String?
  major          String?
  degree         String?
  order          Int       @default(0)
  admissionDate  DateTime?
  graduationDate DateTime?

  @@unique([userId, level, school])
}

/** 인사카드의 [외부경력사항] — 입사 전 다른 회사에서의 근무 이력. */
model CareerHistory {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  title     String?
  duties    String?
  startDate DateTime?
  endDate   DateTime?
  order     Int       @default(0)

  @@index([userId])
}

/** 인사카드의 [자격사항] — 보유 자격증/면허. */
model Certification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  issuer       String?
  certNumber   String?
  acquiredDate DateTime?
  expiryDate   DateTime?
  order        Int       @default(0)

  @@index([userId])
}

/** 인사카드의 [상벌사항] — 포상/징계 이력. */
model CommendationDiscipline {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // 상 | 벌
  category   String?
  reason     String?
  authority  String?
  startDate  DateTime?
  endDate    DateTime?
  order      Int       @default(0)

  @@index([userId])
}

model UserTargetYear {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  createdAt DateTime @default(now())

  @@unique([userId, year])
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  leaderId  String?
  leader    User?    @relation("TeamLeader", fields: [leaderId], references: [id])

  businessUnit String?
  division     String?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)

  createdAt DateTime @default(now())

  members       User[]         @relation("TeamMember")
  onboardingSessions OnboardingSession[] @relation("OnboardingSessionTeam")
  templateItems TemplateItem[]
  jobDescription JobDescription?
  tasks         Task[]
}

model JobDescription {
  id                 String   @id @default(cuid())
  teamId             String   @unique
  team               Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  responsibilities   String?
  purpose            String?
  relatedDepartments String?
  qualifications     String?
  languages          String?
  fileName           String?
  fileType           String?
  fileData           Bytes?
  fileUpdatedAt      DateTime?
  updatedAt          DateTime @updatedAt
}

model EvaluationTemplate {
  id          String       @id @default(cuid())
  title       String
  description String?
  kind        TemplateKind @default(COMPETENCY)
  createdById String
  createdBy   User         @relation("TemplateCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  items  TemplateItem[]
  cycles EvaluationCycle[]
}

model TemplateItem {
  id          String             @id @default(cuid())
  templateId  String
  template    EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category    String             @default("")
  label       String
  description String?
  type        ItemType           @default(SCORE)
  maxScore    Int                @default(5)
  order       Int                @default(0)
  teamId      String?
  team        Team?              @relation(fields: [teamId], references: [id])
  assigneeId  String?
  assignee    User?              @relation("AssignedItems", fields: [assigneeId], references: [id])

  // performance (KPI/goal) fields
  weight        Float?
  currentLevel  String?
  targetLevel   String?
  kpiFormula    String?
  gradeCriteria String?

  scores EvaluationScore[]
}

model EvaluationCycle {
  id              String      @id @default(cuid())
  name            String
  templateId      String
  template        EvaluationTemplate @relation(fields: [templateId], references: [id])
  startDate       DateTime
  endDate         DateTime
  status          CycleStatus @default(DRAFT)
  resultsReleased Boolean     @default(false)
  createdAt       DateTime    @default(now())

  evaluations Evaluation[]
}

model Evaluation {
  id          String           @id @default(cuid())
  cycleId     String
  cycle       EvaluationCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  evaluatorId String
  evaluator   User             @relation("Evaluator", fields: [evaluatorId], references: [id])
  evaluateeId String
  evaluatee   User             @relation("Evaluatee", fields: [evaluateeId], references: [id])
  status      EvaluationStatus @default(PENDING)
  submittedAt DateTime?
  managerComment String?
  selfStatus     EvaluationStatus @default(PENDING)
  selfSubmittedAt DateTime?
  createdAt   DateTime         @default(now())

  scores   EvaluationScore[]
  comments Comment[]

  @@unique([cycleId, evaluatorId, evaluateeId])
}

model EvaluationScore {
  id             String       @id @default(cuid())
  evaluationId   String
  evaluation     Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  templateItemId String
  templateItem   TemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Cascade)
  score          Int?
  comment        String?
  selfScore      Int?
  selfComment    String?
  grade          String?
  selfGrade      String?

  @@unique([evaluationId, templateItemId])
}

model Comment {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])
  body         String
  createdAt    DateTime   @default(now())
}

model Notification {
  id           String           @id @default(cuid())
  recipientId  String
  recipient    User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type         NotificationType
  evaluationId String?
  // 평가 알림은 evaluationId로 상세 화면을 찾아가지만, 온보딩처럼 평가와
  // 무관한 알림은 갈 곳을 직접 담아야 클릭해서 이동할 수 있다.
  link         String?
  message      String
  readAt       DateTime?
  createdAt    DateTime         @default(now())
}

/**
 * SG 인적성검사: 핵심인재 지정 직원의 자가진단 응답이 모여 "기준 프로파일"이
 * 되고, 초대 링크로 응시한 외부 지원자의 프로파일과 비교해 적합도를 낸다.
 * userId가 있으면 내부 직원, inviteLinkId가 있으면 외부 지원자 응답이다.
 */
model CompetencyAssessmentResponse {
  id             String            @id @default(cuid())
  userId         String?           @unique
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteLinkId   String?           @unique
  inviteLink     SurveyInviteLink? @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  respondentName String?
  answers        Json
  scores         Json
  overallScore   Float
  createdAt      DateTime          @default(now())
}

/** 외부 지원자용 1회성 응시 링크. */
model SurveyInviteLink {
  id            String   @id @default(cuid())
  token         String   @unique @default(cuid())
  applicantName String?
  note          String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  response CompetencyAssessmentResponse?
}

enum Module {
  EMPLOYEES
  ORG_CHART
  JOB_MANAGEMENT
  TASK_MANAGEMENT
  LEGAL_LIBRARY
  HR_REPORT
  EVALUATION
  TALENT_ASSESSMENT
  ONBOARDING
}

enum PermissionScope {
  NONE
  SELF
  TEAM
  DIVISION
  BUSINESS_UNIT
  FULL
  /** EMPLOYEES 모듈 전용: 목록은 전체 공개하되 개인 인사카드 상세는 본인만. */
  LIST_ONLY
}

model PermissionMatrixEntry {
  id       String          @id @default(cuid())
  position Position
  module   Module
  scope    PermissionScope @default(FULL)

  @@unique([position, module])
}

/**
 * Per-user override of the position-based PermissionMatrixEntry — e.g. an
 * HR 본부장 whose position would normally cap them at DIVISION scope, but
 * who should individually see FULL for the EMPLOYEES module. When present
 * for a (userId, module) pair, this wins over the position's matrix entry.
 */
model UserPermissionOverride {
  id     String          @id @default(cuid())
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module
  scope  PermissionScope

  @@unique([userId, module])
}

/**
 * 업무 관리 모듈: 칸반보드/캘린더·타임라인/To-do 세 화면이 공유하는
 * 하나의 작업 단위. status로 칸반 컬럼을, dueDate로 캘린더·타임라인
 * 정렬을, assignee가 나인 것만 필터링하면 To-do 목록이 된다.
 */
model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  teamId      String?
  team        Team?      @relation(fields: [teamId], references: [id])
  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  subtasks Subtask[]

  @@index([assigneeId])
  @@index([status])
}

/** 업무 관리 > 하위 체크리스트 항목. */
model Subtask {
  id     String  @id @default(cuid())
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title  String
  done   Boolean @default(false)
  order  Int     @default(0)

  @@index([taskId])
}

/** 업무 관리 > SOP: 반복 업무의 표준 절차 문서. */
model SopDocument {
  id          String   @id @default(cuid())
  title       String
  category    String?
  content     String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/** 업무 관리 > 업무일지 DB: 개인별 일일 업무 기록. */
model WorkLogEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  content   String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

enum HomeBlock {
  TEAM_SUMMARY
  OVERALL_SUMMARY
  QUICK_LINKS
}

model HomeLayoutEntry {
  id       String    @id @default(cuid())
  position Position
  block    HomeBlock
  visible  Boolean   @default(true)

  @@unique([position, block])
}

/**
 * Global (not per-position) sidebar display config for the main nav
 * module list: display order and whether it shows a "개발 중" badge.
 * Absence of a row falls back to declaration order and comingSoon=false.
 */
model ModuleUiConfig {
  id         String  @id @default(cuid())
  module     Module  @unique
  order      Int     @default(0)
  comingSoon Boolean @default(false)
  hidden     Boolean @default(false)
}

enum ErpBatchStatus {
  PENDING_REVIEW
  APPLIED
  DISCARDED
  ROLLED_BACK
}

enum ErpRowStatus {
  NEW
  CHANGED
  UNCHANGED
  TERMINATION
  NEEDS_MAPPING
  SKIPPED
  ERROR
}

/**
 * ERP 원본 사원명부 일일 업로드 배치. 업로드해도 바로 반영되지 않고
 * PENDING_REVIEW 상태로 대기 — 관리자가 미리보기에서 확인/매핑 후
 * 승인한 행만 실제 User/Team 데이터에 반영된다 (applyErpBatch).
 */
model ErpImportBatch {
  id           String         @id @default(cuid())
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  fileName     String
  status       ErpBatchStatus @default(PENDING_REVIEW)
  totalRows    Int
  createdAt    DateTime       @default(now())
  appliedAt    DateTime?
  rolledBackAt DateTime?

  rows ErpImportRow[]
}

/**
 * 배치 내 행 단위 원본 데이터 + 계산된 변경 diff + 승인 여부.
 * appliedOutcome/appliedUserId는 실제 반영 시 이 행이 어떤 User에게
 * 무엇을 했는지 기록 — 되돌리기(rollbackErpBatch)가 diff의 이전값으로
 * 정확히 복구할 대상을 찾는 데 쓰인다.
 */
model ErpImportRow {
  id             String         @id @default(cuid())
  batchId        String
  batch          ErpImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeNumber String
  name           String
  status         ErpRowStatus
  rawData        Json
  diff           Json?
  errorMessage   String?
  approved       Boolean        @default(true)
  appliedOutcome String?
  appliedUserId  String?

  @@index([batchId])
}

/**
 * ERP 원문 값 → 시스템 값 학습형 매핑. field="POSITION"이면
 * targetValue는 Position enum 문자열, field="TEAM"이면 targetValue는
 * teamId. 한 번 지정하면 이후 업로드부터 자동 적용된다.
 */
model ErpFieldMapping {
  id          String   @id @default(cuid())
  field       String
  rawValue    String
  targetValue String
  createdAt   DateTime @default(now())

  @@unique([field, rawValue])
}

/**
 * 관리자 "일일 트래픽" 화면 집계용 방문 기록. 로그인한 사용자가
 * PlatformShell로 감싸인 화면(플랫폼/관리자 페이지 전체)을 열 때마다
 * 한 건씩 쌓이는 페이지뷰 로그 — 일별 총 조회수/순 방문자 수 집계에 쓰인다.
 */
model PageView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/**
 * 일정 한 칸의 진행 상태. 관리자가 틀을 잡으면 PLANNED, 배정된 강사가
 * 시간을 조정해 보내면 SUBMITTED, 관리자가 확정하면 CONFIRMED가 되고 그때
 * 비로소 [최종 스케줄]에 나타난다.
 */
enum OnboardingSessionStatus {
  PLANNED
  SUBMITTED
  DECLINED
  CONFIRMED
}

/**
 * 관리자가 주는 가이드라인의 단위. 분 단위까지 미리 정하지 않고 "그 날 오전"
 * 정도만 잡아 두면, 강사가 되는 쪽을 고르고 관리자가 마지막에 실제 시각을
 * 짠다.
 */
/**
 * 온보딩 프로그램 = 한 기수(차수). 실제 교육 시간표는 이 아래
 * OnboardingSession으로 달린다 — 기수가 바뀌어도 지난 기수의 일정과 강사
 * 배정 이력이 그대로 남아야 하므로 세션을 프로그램에 묶는다.
 */
model OnboardingProgram {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean   @default(true)
  createdById String
  createdBy   User      @relation("OnboardingProgramCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  sessions OnboardingSession[]
  trainees OnboardingTrainee[]
}

/**
 * 시간표의 한 칸. 관리자가 날짜와 시각을 잡아 두고, 강사에게 물어볼 일이면
 * 배정된 강사가 가능 여부를 답한 뒤 관리자가 시각을 확정한다. 물어볼 것 없이
 * 관리자가 바로 확정하는 경우도 있다. 확정된 칸만 [최종 스케줄]에 나간다.
 */
model OnboardingSession {
  id          String                @id @default(cuid())
  programId   String
  program     OnboardingProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  status      OnboardingSessionStatus @default(PLANNED)
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  location    String?

  // 이 칸을 맡은 강사. 강사는 본인에게 배정된 칸에만 답할 수 있으므로,
  // 권한 판단의 기준이기도 하다.
  instructorId String?
  instructor   User?   @relation("OnboardingSessionInstructor", fields: [instructorId], references: [id])

  // 사람을 못 박지 않고 부서에 맡기는 경우 — 그 날 시간이 되는 사람이 맡는
  // 식이라 미리 이름을 적을 수 없다. 팀이 배정되면 그 팀 소속 강사 누구나
  // 시간을 잡을 수 있고, 먼저 전송한 사람이 instructorId로 들어간다.
  // 끝까지 정해지지 않으면 최종 스케줄에는 팀 이름으로 나간다.
  instructorTeamId String?
  instructorTeam   Team?   @relation("OnboardingSessionTeam", fields: [instructorTeamId], references: [id])

  // 부서에 맡길 때, 강사를 정할 권한을 팀장 한 사람으로 좁힐지. 부서원 전원이
  // 지정할 수 있으면 두 사람이 동시에 손대 서로의 지정을 덮어쓸 수 있어서,
  // 그럴 여지를 없애야 하는 부서를 위해 둔다.
  leaderOnly Boolean @default(false)

  // 강사(또는 부서 팀장)의 응답. 가능하면 되는 시각을 적고, 불가하면 사유를
  // 남긴다 — 어느 쪽이든 관리자가 다음 수를 두려면 이유가 필요하다.
  // 관리자가 제안한 시각(startAt·endAt)과 다를 수 있어 따로 담는다.
  instructorStartAt DateTime?
  instructorEndAt   DateTime?
  instructorNote    String?
  respondedAt    DateTime?
  confirmedAt    DateTime?

  createdById String?
  createdBy   User?    @relation("OnboardingSessionCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendees OnboardingSessionAttendee[]

  @@index([programId, startAt])
  @@index([instructorId, status])
  @@index([instructorTeamId, status])
}

/**
 * 기수에 참석하는 교육생(신입사원) 명단. 기수마다 사람이 완전히 바뀌므로
 * 프로그램에 묶는다 — 지난 기수 명단이 그대로 남아야 "누가 어느 기수를
 * 들었는지"를 나중에 확인할 수 있다.
 */
model OnboardingTrainee {
  id        String            @id @default(cuid())
  programId String
  program   OnboardingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("OnboardingTrainee", fields: [userId], references: [id], onDelete: Cascade)
  note      String?
  addedById String?
  addedBy   User?             @relation("OnboardingTraineeAdder", fields: [addedById], references: [id])
  createdAt DateTime          @default(now())

  attendances OnboardingSessionAttendee[]

  @@unique([programId, userId])
  @@index([userId])
}

/**
 * 특정 교육을 일부 교육생만 듣는 경우의 대상 지정. 한 건도 없으면 그 교육은
 * 기수 전원이 대상이다 — 온보딩 교육은 대부분 전원 필수라 기본을 "전원"으로
 * 두고, 예외인 교육에만 명단을 넣는 편이 관리 부담이 적다.
 */
model OnboardingSessionAttendee {
  id        String            @id @default(cuid())
  sessionId String
  session   OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  traineeId String
  trainee   OnboardingTrainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, traineeId])
  @@index([traineeId])
}

/**
 * 사내규정 원문 1건(취업규칙, 임원관리규정, 복지규정 ...). 원본 파일은
 * JobDescription.fileData와 같이 Bytes로 들고 있는다 — 파서를 고쳐서
 * 재파싱할 때 원본이 없으면 다시 업로드받아야 하기 때문.
 */
model Regulation {
  id            String               @id @default(cuid())
  title         String
  category      String?
  /** 개정일. 같은 규정의 구버전과 구분해야 "현재 유효한 조항"을 답할 수 있다. */
  revisedAt     DateTime?
  /** false면 검색·챗봇 답변에서 제외한다(폐지·구버전 보관용). */
  isActive      Boolean              @default(true)
  fileName      String?
  fileType      String?
  fileData      Bytes?
  /** 파싱 원문. 조문 재파싱 시 파일 재추출 없이 여기서 바로 돌린다. */
  sourceText    String?
  articleCount  Int                  @default(0)
  articles      RegulationArticle[]
  uploadedById  String?
  uploadedBy    User?                @relation("RegulationUploader", fields: [uploadedById], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive])
}

/**
 * 조(條) 하나 = 한 행. 챗봇이 "취업규칙 제23조 ②항" 같은 근거를 달 수
 * 있어야 하므로 검색·인용 단위를 조문으로 고정한다. 고정 길이 청킹은
 * 한 조가 둘로 갈리거나 두 조가 한 덩어리로 섞여서 인용이 불가능하다.
 */
model RegulationArticle {
  id           String     @id @default(cuid())
  regulationId String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  /** 문서 내 원문 순서. 목차를 원문 순서대로 재현하는 데 쓴다. */
  order        Int
  /** 인용 표기. 예: "제23조", "제23조의2", "부칙 제1조" */
  label        String
  articleNo    Int
  /** 가지번호(제23조의2의 "2"). 없으면 null. */
  branchNo     Int?
  title        String?
  chapter      String?
  section      String?
  /** 부칙은 조 번호가 제1조부터 다시 시작해서 본칙과 구분이 필요하다. */
  isAddenda    Boolean    @default(false)
  body         String

  @@index([regulationId, order])
  @@index([articleNo])
}
