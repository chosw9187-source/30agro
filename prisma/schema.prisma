// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EVALUATOR
  EMPLOYEE
}

enum ItemType {
  SCORE
  TEXT
  GRADE
}

enum TemplateKind {
  COMPETENCY
  PERFORMANCE
}

enum CycleStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EvaluationStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
}

enum NotificationType {
  SELF_ASSESSMENT_SUBMITTED
  COMMENT_ADDED
  ONBOARDING_BOOKING_REQUESTED
  ONBOARDING_BOOKING_DECIDED
  ONBOARDING_SCHEDULE_CHANGED
  ONBOARDING_NOTICE_POSTED
}

enum Position {
  CEO
  OPERATIONS_HEAD
  SENIOR_STAFF
  TEAM_LEADER
  STAFF
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String?   @unique
  employeeNumber      String    @unique
  passwordHash        String
  mustChangePassword  Boolean   @default(true)
  role                Role
  position            Position  @default(STAFF)
  birthDate           DateTime?
  hireDate            DateTime?
  terminationDate     DateTime?
  employmentType      String?
  jobGrade            String?
  educationLevel      String?
  school              String?
  major               String?
  degree              String?
  jobFamily           String?
  gender              String?
  photo               Bytes?
  photoType           String?
  businessUnit        String?
  division            String?
  isKeyTalent         Boolean   @default(false)
  hiddenFromDirectory Boolean   @default(false)
  teamId              String?
  team                Team?     @relation("TeamMember", fields: [teamId], references: [id])
  createdAt           DateTime  @default(now())

  createdTemplates         EvaluationTemplate[]           @relation("TemplateCreator")
  evaluationsGiven         Evaluation[]                   @relation("Evaluator")
  evaluationsOwned         Evaluation[]                   @relation("Evaluatee")
  comments                 Comment[]
  ledTeams                 Team[]                         @relation("TeamLeader")
  assignedItems            TemplateItem[]                 @relation("AssignedItems")
  notifications            Notification[]                 @relation("NotificationRecipient")
  targetYears              UserTargetYear[]
  appointmentRecords       AppointmentRecord[]
  performanceHistory       PerformanceHistory[]
  educationRecords         EducationRecord[]
  careerHistory            CareerHistory[]
  certifications           Certification[]
  commendationDiscipline   CommendationDiscipline[]
  permissionOverrides      UserPermissionOverride[]
  tasksAssigned            Task[]                         @relation("TaskAssignee")
  tasksCreated             Task[]                         @relation("TaskCreator")
  sopDocuments             SopDocument[]
  workLogEntries           WorkLogEntry[]
  surveyInvitesCreated     SurveyInviteLink[]
  competencyResponses      CompetencyAssessmentResponse[]
  erpImportBatches         ErpImportBatch[]
  pageViews                PageView[]
  onboardingPrograms       OnboardingProgram[]            @relation("OnboardingProgramCreator")
  uploadedRegulations      Regulation[]                   @relation("RegulationUploader")
  onboardingSessionsAdded  OnboardingSession[]            @relation("OnboardingSessionCreator")
  onboardingLogisticsAdded OnboardingLogistics[]          @relation("OnboardingLogisticsCreator")
  onboardingSessionsTaught OnboardingSessionInstructor[]
  onboardingTrainee        OnboardingTrainee[]            @relation("OnboardingTrainee")
  onboardingTraineesAdded  OnboardingTrainee[]            @relation("OnboardingTraineeAdder")
  goalsOwned               Goal[]                         @relation("GoalOwner")
  goalsCreated             Goal[]                         @relation("GoalCreator")
  goalCheckIns             GoalCheckIn[]                  @relation("GoalCheckInAuthor")
  goalsAgreed              Goal[]                         @relation("GoalAgreedBy")
  goalCycleTargets         GoalCycleTarget[]              @relation("GoalCycleTargetUser")
  goalSheetInfos           GoalSheetInfo[]                @relation("GoalSheetInfoUser")
  goalCycleTargetsSet      GoalCycleTarget[]              @relation("GoalCycleTargetSetter")
  goalCyclesLocked         GoalCycle[]                    @relation("GoalCycleLockedBy")
  goalCheckpoints          GoalCheckpoint[]               @relation("GoalCheckpointCreator")
  competencyReviews        CompetencyReview[]             @relation("CompetencyReviewee")
  competencyLeadRatings    CompetencyScore[]              @relation("CompetencyLeadRater")
  competencyJobOverride    CompetencyJobAssignment[]      @relation("CompetencyJobUser")
  competencyTargetRows     CompetencyTarget[]             @relation("CompetencyTargetUser")
  competencyFormsLocked    CompetencyForm[]               @relation("CompetencyFormLockedBy")
  finalGrades              FinalGrade[]                   @relation("FinalGradeUser")
  finalGradesFixed         FinalGrade[]                   @relation("FinalGradeFixedBy")
  gradeBonuses             GradeBonus[]                   @relation("GradeBonusUser")
  gradeBonusesSet          GradeBonus[]                   @relation("GradeBonusSetBy")
}

model AppointmentRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  type          String?
  title         String?
  department    String?
  positionTitle String?
  jobGrade      String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([userId, date])
}

model PerformanceHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  grade     String?
  score     Float?
  note      String?
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
}

model EducationRecord {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level          String // 고등학교 | 대학교 | 대학원(석사) | 대학원(박사)
  school         String?
  major          String?
  degree         String?
  order          Int       @default(0)
  admissionDate  DateTime?
  graduationDate DateTime?

  @@unique([userId, level, school])
}

/**
 * 인사카드의 [외부경력사항] — 입사 전 다른 회사에서의 근무 이력.
 */
model CareerHistory {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  title     String?
  duties    String?
  startDate DateTime?
  endDate   DateTime?
  order     Int       @default(0)

  @@index([userId])
}

/**
 * 인사카드의 [자격사항] — 보유 자격증/면허.
 */
model Certification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  issuer       String?
  certNumber   String?
  acquiredDate DateTime?
  expiryDate   DateTime?
  order        Int       @default(0)

  @@index([userId])
}

/**
 * 인사카드의 [상벌사항] — 포상/징계 이력.
 */
model CommendationDiscipline {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 상 | 벌
  category  String?
  reason    String?
  authority String?
  startDate DateTime?
  endDate   DateTime?
  order     Int       @default(0)

  @@index([userId])
}

model UserTargetYear {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  createdAt DateTime @default(now())

  @@unique([userId, year])
}

model Team {
  id       String  @id @default(cuid())
  name     String  @unique
  leaderId String?
  leader   User?   @relation("TeamLeader", fields: [leaderId], references: [id])

  businessUnit String?
  division     String?
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())

  members              User[]                    @relation("TeamMember")
  onboardingSessions   OnboardingSessionTeam[]
  templateItems        TemplateItem[]
  jobDescription       JobDescription?
  tasks                Task[]
  goals                Goal[]
  competencyJobSets    CompetencyJobAssignment[] @relation("CompetencyJobTeam")
  competencyTargetRows CompetencyTarget[]        @relation("CompetencyTargetTeam")
}

model JobDescription {
  id                 String    @id @default(cuid())
  teamId             String    @unique
  team               Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  responsibilities   String?
  purpose            String?
  relatedDepartments String?
  qualifications     String?
  languages          String?
  fileName           String?
  fileType           String?
  fileData           Bytes?
  fileUpdatedAt      DateTime?
  updatedAt          DateTime  @updatedAt
}

model EvaluationTemplate {
  id          String       @id @default(cuid())
  title       String
  description String?
  kind        TemplateKind @default(COMPETENCY)
  createdById String
  createdBy   User         @relation("TemplateCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  items  TemplateItem[]
  cycles EvaluationCycle[]
}

model TemplateItem {
  id          String             @id @default(cuid())
  templateId  String
  template    EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category    String             @default("")
  label       String
  description String?
  type        ItemType           @default(SCORE)
  maxScore    Int                @default(5)
  order       Int                @default(0)
  teamId      String?
  team        Team?              @relation(fields: [teamId], references: [id])
  assigneeId  String?
  assignee    User?              @relation("AssignedItems", fields: [assigneeId], references: [id])

  // performance (KPI/goal) fields
  weight        Float?
  currentLevel  String?
  targetLevel   String?
  kpiFormula    String?
  gradeCriteria String?

  scores EvaluationScore[]
}

model EvaluationCycle {
  id              String             @id @default(cuid())
  name            String
  templateId      String
  template        EvaluationTemplate @relation(fields: [templateId], references: [id])
  startDate       DateTime
  endDate         DateTime
  status          CycleStatus        @default(DRAFT)
  resultsReleased Boolean            @default(false)
  createdAt       DateTime           @default(now())

  evaluations Evaluation[]
}

model Evaluation {
  id              String           @id @default(cuid())
  cycleId         String
  cycle           EvaluationCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  evaluatorId     String
  evaluator       User             @relation("Evaluator", fields: [evaluatorId], references: [id])
  evaluateeId     String
  evaluatee       User             @relation("Evaluatee", fields: [evaluateeId], references: [id])
  status          EvaluationStatus @default(PENDING)
  submittedAt     DateTime?
  managerComment  String?
  selfStatus      EvaluationStatus @default(PENDING)
  selfSubmittedAt DateTime?
  createdAt       DateTime         @default(now())

  scores   EvaluationScore[]
  comments Comment[]

  @@unique([cycleId, evaluatorId, evaluateeId])
}

model EvaluationScore {
  id             String       @id @default(cuid())
  evaluationId   String
  evaluation     Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  templateItemId String
  templateItem   TemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Cascade)
  score          Int?
  comment        String?
  selfScore      Int?
  selfComment    String?
  grade          String?
  selfGrade      String?

  @@unique([evaluationId, templateItemId])
}

model Comment {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])
  body         String
  createdAt    DateTime   @default(now())
}

model Notification {
  id           String           @id @default(cuid())
  recipientId  String
  recipient    User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type         NotificationType
  evaluationId String?
  // 평가 알림은 evaluationId로 상세 화면을 찾아가지만, 온보딩처럼 평가와
  // 무관한 알림은 갈 곳을 직접 담아야 클릭해서 이동할 수 있다.
  link         String?
  message      String
  readAt       DateTime?
  createdAt    DateTime         @default(now())
}

/**
 * SG 인적성검사: 핵심인재 지정 직원의 자가진단 응답이 모여 "기준 프로파일"이
 * 되고, 초대 링크로 응시한 외부 지원자의 프로파일과 비교해 적합도를 낸다.
 * userId가 있으면 내부 직원, inviteLinkId가 있으면 외부 지원자 응답이다.
 */
model CompetencyAssessmentResponse {
  id             String            @id @default(cuid())
  userId         String?           @unique
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteLinkId   String?           @unique
  inviteLink     SurveyInviteLink? @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  respondentName String?
  answers        Json
  scores         Json
  overallScore   Float
  createdAt      DateTime          @default(now())
}

/**
 * 외부 지원자용 1회성 응시 링크.
 */
model SurveyInviteLink {
  id            String   @id @default(cuid())
  token         String   @unique @default(cuid())
  applicantName String?
  note          String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  response CompetencyAssessmentResponse?
}

enum Module {
  EMPLOYEES
  ORG_CHART
  JOB_MANAGEMENT
  TASK_MANAGEMENT
  LEGAL_LIBRARY
  HR_REPORT
  EVALUATION
  EVALUATION_V2
  TALENT_ASSESSMENT
  ONBOARDING
}

enum PermissionScope {
  NONE
  SELF
  TEAM
  DIVISION
  BUSINESS_UNIT
  FULL
  /**
   * EMPLOYEES 모듈 전용: 목록은 전체 공개하되 개인 인사카드 상세는 본인만.
   */
  LIST_ONLY
}

model PermissionMatrixEntry {
  id       String          @id @default(cuid())
  position Position
  module   Module
  scope    PermissionScope @default(FULL)

  @@unique([position, module])
}

/**
 * Per-user override of the position-based PermissionMatrixEntry — e.g. an
 * HR 본부장 whose position would normally cap them at DIVISION scope, but
 * who should individually see FULL for the EMPLOYEES module. When present
 * for a (userId, module) pair, this wins over the position's matrix entry.
 */
model UserPermissionOverride {
  id     String          @id @default(cuid())
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module
  scope  PermissionScope

  @@unique([userId, module])
}

/**
 * 업무 관리 모듈: 칸반보드/캘린더·타임라인/To-do 세 화면이 공유하는
 * 하나의 작업 단위. status로 칸반 컬럼을, dueDate로 캘린더·타임라인
 * 정렬을, assignee가 나인 것만 필터링하면 To-do 목록이 된다.
 */
model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  teamId      String?
  team        Team?        @relation(fields: [teamId], references: [id])
  createdById String
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subtasks Subtask[]

  @@index([assigneeId])
  @@index([status])
}

/**
 * 업무 관리 > 하위 체크리스트 항목.
 */
model Subtask {
  id     String  @id @default(cuid())
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title  String
  done   Boolean @default(false)
  order  Int     @default(0)

  @@index([taskId])
}

/**
 * 업무 관리 > SOP: 반복 업무의 표준 절차 문서.
 */
model SopDocument {
  id          String   @id @default(cuid())
  title       String
  category    String?
  content     String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * 업무 관리 > 업무일지 DB: 개인별 일일 업무 기록.
 */
model WorkLogEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  content   String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

enum HomeBlock {
  TEAM_SUMMARY
  OVERALL_SUMMARY
  QUICK_LINKS
}

model HomeLayoutEntry {
  id       String    @id @default(cuid())
  position Position
  block    HomeBlock
  visible  Boolean   @default(true)

  @@unique([position, block])
}

/**
 * Global (not per-position) sidebar display config for the main nav
 * module list: display order and whether it shows a "개발 중" badge.
 * Absence of a row falls back to declaration order and comingSoon=false.
 */
model ModuleUiConfig {
  id         String  @id @default(cuid())
  module     Module  @unique
  order      Int     @default(0)
  comingSoon Boolean @default(false)
  hidden     Boolean @default(false)
  /**
   * 사이드바에 표시할 커스텀 이름. null이면 기본 이름을 그대로 쓴다.
   */
  label      String?
}

/**
 * 사이드바 "관리"(admin) 섹션 항목별 숨김 여부. key는 AdminMenuKey 문자열.
 */
model AdminMenuConfig {
  id     String  @id @default(cuid())
  key    String  @unique
  hidden Boolean @default(false)
}

enum ErpBatchStatus {
  PENDING_REVIEW
  APPLIED
  DISCARDED
  ROLLED_BACK
}

enum ErpRowStatus {
  NEW
  CHANGED
  UNCHANGED
  TERMINATION
  NEEDS_MAPPING
  SKIPPED
  ERROR
}

/**
 * ERP 원본 사원명부 일일 업로드 배치. 업로드해도 바로 반영되지 않고
 * PENDING_REVIEW 상태로 대기 — 관리자가 미리보기에서 확인/매핑 후
 * 승인한 행만 실제 User/Team 데이터에 반영된다 (applyErpBatch).
 */
model ErpImportBatch {
  id           String         @id @default(cuid())
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  fileName     String
  status       ErpBatchStatus @default(PENDING_REVIEW)
  totalRows    Int
  createdAt    DateTime       @default(now())
  appliedAt    DateTime?
  rolledBackAt DateTime?

  rows ErpImportRow[]
}

/**
 * 배치 내 행 단위 원본 데이터 + 계산된 변경 diff + 승인 여부.
 * appliedOutcome/appliedUserId는 실제 반영 시 이 행이 어떤 User에게
 * 무엇을 했는지 기록 — 되돌리기(rollbackErpBatch)가 diff의 이전값으로
 * 정확히 복구할 대상을 찾는 데 쓰인다.
 */
model ErpImportRow {
  id             String         @id @default(cuid())
  batchId        String
  batch          ErpImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeNumber String
  name           String
  status         ErpRowStatus
  rawData        Json
  diff           Json?
  errorMessage   String?
  approved       Boolean        @default(true)
  appliedOutcome String?
  appliedUserId  String?

  @@index([batchId])
}

/**
 * ERP 원문 값 → 시스템 값 학습형 매핑. field="POSITION"이면
 * targetValue는 Position enum 문자열, field="TEAM"이면 targetValue는
 * teamId. 한 번 지정하면 이후 업로드부터 자동 적용된다.
 */
model ErpFieldMapping {
  id          String   @id @default(cuid())
  field       String
  rawValue    String
  targetValue String
  createdAt   DateTime @default(now())

  @@unique([field, rawValue])
}

/**
 * 관리자 "일일 트래픽" 화면 집계용 방문 기록. 로그인한 사용자가
 * PlatformShell로 감싸인 화면(플랫폼/관리자 페이지 전체)을 열 때마다
 * 한 건씩 쌓이는 페이지뷰 로그 — 일별 총 조회수/순 방문자 수 집계에 쓰인다.
 */
model PageView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/**
 * 온보딩 프로그램 = 한 기수(차수). 실제 교육 시간표는 이 아래
 * OnboardingSession으로 달린다 — 기수가 바뀌어도 지난 기수의 일정과 강사
 * 배정 이력이 그대로 남아야 하므로 세션을 프로그램에 묶는다.
 */
model OnboardingProgram {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?

  // 기수 전체에 걸리는 공지. 숙박·교통은 교육마다 달라질 수 있어 여기 두지
  // 않고 OnboardingSession에 붙인다.
  notice String? @db.Text

  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation("OnboardingProgramCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  sessions  OnboardingSession[]
  trainees  OnboardingTrainee[]
  logistics OnboardingLogistics[]
}

/**
 * 숙박이냐 이동이냐. 안내서에서 아이콘과 묶는 순서를 가르는 데 쓴다.
 */
enum OnboardingLogisticsKind {
  LODGING
  TRANSPORT
}

/**
 * 날짜에 걸리는 숙박·교통 안내.
 * 강의 한 건에 딸린 정보가 아니다 — 숙박은 밤에 걸리고, 전세버스는 그 날
 * 아침에 한 번 뜬다. 강의에 붙여 두면 "8/12 오전 강의"와 "8/12 오후 강의"에
 * 같은 숙소를 두 번 적게 되고, 강의가 없는 이동일에는 적을 자리가 없다.
 * 그래서 일정과 나란히 놓이는 별도 항목으로 둔다.
 */
model OnboardingLogistics {
  id        String                  @id @default(cuid())
  programId String
  program   OnboardingProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  kind      OnboardingLogisticsKind

  // 하루짜리면 startDate만, 1박 2일처럼 걸쳐 있으면 endDate까지.
  startDate DateTime
  endDate   DateTime?

  title  String
  detail String? @db.Text

  createdById String?
  createdBy   User?    @relation("OnboardingLogisticsCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([programId, startDate])
}

/**
 * 시간표의 한 칸. 일정과 강사는 이 화면 밖에서 미리 합의하고 여기에는 그
 * 결과만 적는다 — 그래서 적히는 즉시 확정본이고, 상태나 조율 절차가 없다.
 */
model OnboardingSession {
  id        String            @id @default(cuid())
  programId String
  program   OnboardingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  title     String
  startAt   DateTime
  endAt     DateTime
  location  String?

  // 두 갈래의 전달사항. description은 강사에게만 넘기는 준비·진행 메모라
  // 안내서에 싣지 않고, traineeNote는 강사가 수강생에게 전하고 싶은 말이라
  // 안내서의 그 교육 자리에 그대로 보인다.
  description String? @db.Text
  traineeNote String? @db.Text

  createdById String?
  createdBy   User?    @relation("OnboardingSessionCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendees   OnboardingSessionAttendee[]
  instructors OnboardingSessionInstructor[]
  teams       OnboardingSessionTeam[]

  @@index([programId, startAt])
}

/**
 * 이 교육을 맡은 강사. 한 과정을 둘이 나눠 진행하거나, 실습에 보조 강사가
 * 붙는 일이 흔해 한 명으로 못 박지 않는다.
 */
model OnboardingSessionInstructor {
  id        String            @id @default(cuid())
  sessionId String
  session   OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

/**
 * 사람 대신 부서가 맡는 경우 — 그 날 시간이 되는 사람이 나가는 식이라 이름을
 * 미리 적을 수 없다. 안내서에는 부서 이름으로 나가고, 부서도 여럿일 수 있다.
 */
model OnboardingSessionTeam {
  id        String            @id @default(cuid())
  sessionId String
  session   OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([sessionId, teamId])
  @@index([teamId])
}

/**
 * 기수에 참석하는 교육생(신입사원) 명단. 기수마다 사람이 완전히 바뀌므로
 * 프로그램에 묶는다 — 지난 기수 명단이 그대로 남아야 "누가 어느 기수를
 * 들었는지"를 나중에 확인할 수 있다.
 */
model OnboardingTrainee {
  id        String            @id @default(cuid())
  programId String
  program   OnboardingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("OnboardingTrainee", fields: [userId], references: [id], onDelete: Cascade)
  note      String?
  addedById String?
  addedBy   User?             @relation("OnboardingTraineeAdder", fields: [addedById], references: [id])
  createdAt DateTime          @default(now())

  attendances OnboardingSessionAttendee[]

  @@unique([programId, userId])
  @@index([userId])
}

/**
 * 특정 교육을 일부 교육생만 듣는 경우의 대상 지정. 한 건도 없으면 그 교육은
 * 기수 전원이 대상이다 — 온보딩 교육은 대부분 전원 필수라 기본을 "전원"으로
 * 두고, 예외인 교육에만 명단을 넣는 편이 관리 부담이 적다.
 */
model OnboardingSessionAttendee {
  id        String            @id @default(cuid())
  sessionId String
  session   OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  traineeId String
  trainee   OnboardingTrainee @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, traineeId])
  @@index([traineeId])
}

/**
 * 사내규정 원문 1건(취업규칙, 임원관리규정, 복지규정 ...). 원본 파일은
 * JobDescription.fileData와 같이 Bytes로 들고 있는다 — 파서를 고쳐서
 * 재파싱할 때 원본이 없으면 다시 업로드받아야 하기 때문.
 */
model Regulation {
  id           String              @id @default(cuid())
  title        String
  category     String?
  /**
   * 개정일. 같은 규정의 구버전과 구분해야 "현재 유효한 조항"을 답할 수 있다.
   */
  revisedAt    DateTime?
  /**
   * false면 검색·챗봇 답변에서 제외한다(폐지·구버전 보관용).
   */
  isActive     Boolean             @default(true)
  fileName     String?
  fileType     String?
  fileData     Bytes?
  /**
   * 파싱 원문. 조문 재파싱 시 파일 재추출 없이 여기서 바로 돌린다.
   */
  sourceText   String?
  articleCount Int                 @default(0)
  articles     RegulationArticle[]
  uploadedById String?
  uploadedBy   User?               @relation("RegulationUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([isActive])
}

/**
 * 조(條) 하나 = 한 행. 챗봇이 "취업규칙 제23조 ②항" 같은 근거를 달 수
 * 있어야 하므로 검색·인용 단위를 조문으로 고정한다. 고정 길이 청킹은
 * 한 조가 둘로 갈리거나 두 조가 한 덩어리로 섞여서 인용이 불가능하다.
 */
model RegulationArticle {
  id           String     @id @default(cuid())
  regulationId String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  /**
   * 문서 내 원문 순서. 목차를 원문 순서대로 재현하는 데 쓴다.
   */
  order        Int
  /**
   * 인용 표기. 예: "제23조", "제23조의2", "부칙 제1조"
   */
  label        String
  articleNo    Int
  /**
   * 가지번호(제23조의2의 "2"). 없으면 null.
   */
  branchNo     Int?
  title        String?
  chapter      String?
  section      String?
  /**
   * 부칙은 조 번호가 제1조부터 다시 시작해서 본칙과 구분이 필요하다.
   */
  isAddenda    Boolean    @default(false)
  body         String

  @@index([regulationId, order])
  @@index([articleNo])
}

// ---------------------------------------------------------------------------
// 평가2 (목표관리) — 전사목표 → 책임목표 → 팀목표 → 개인목표 4단 캐스케이드
// ---------------------------------------------------------------------------

/**
 * 목표가 걸리는 조직 계층. 조직도(사업단위 > 책임 > 팀 > 개인)와 같은
 * 층위를 쓰되, 목표는 "책임"부터 나눠 내려가므로 사업단위 층은 두지 않는다.
 */
enum GoalLevel {
  COMPANY
  DIVISION
  TEAM
  INDIVIDUAL
}

enum GoalStatus {
  /**
   * 작성 중 — 상위에서 확정되기 전
   */
  DRAFT
  /**
   * 진행 중
   */
  ACTIVE
  /**
   * 달성 완료
   */
  DONE
  /**
   * 중단·폐기
   */
  DROPPED
}

/**
 * 개인목표 합의 단계. 팀원이 목표를 세워 합의를 요청하면 팀장이 승인하거나
 * 되돌린다. 승인(AGREED)된 목표만 나중에 성과평가 대상이 된다 — 확정되지
 * 않은 목표에 점수를 매기면 평가가 성립하지 않는다.
 */
enum GoalAgreementStatus {
  /**
   * 작성 중 — 아직 팀장에게 올리지 않음
   */
  DRAFT
  /**
   * 합의 요청 — 팀장 승인 대기
   */
  REQUESTED
  /**
   * 합의 완료 — 팀장 승인됨
   */
  AGREED
  /**
   * 되돌림 — 팀장이 사유를 달아 반려
   */
  RETURNED
}

enum GoalCycleStatus {
  DRAFT
  OPEN
  CLOSED
}

/**
 * 목표 운영 기간(예: 2026년 상반기). 모든 목표는 한 사이클에 속한다.
 */
model GoalCycle {
  id        String          @id @default(cuid())
  name      String
  year      Int
  startDate DateTime
  endDate   DateTime
  status    GoalCycleStatus @default(DRAFT)

  /**
   * 목록에 늘어놓는 순서. 관리자가 위·아래로 옮겨 정한다.
   * 연도·기간순으로만 세우면 "2026년 목표설정 → 상반기 → 최종평가"처럼 일이
   * 진행되는 순서로 못 늘어놓는다. 상반기(1~6월)가 목표설정(7~12월)보다 앞선
   * 기간이라 날짜로는 뒤집히기 때문이다. 0이면 아직 정하지 않은 것이라
   * 날짜순으로 떨어진다.
   */
  sortOrder Int @default(0)

  /**
   * 입사일 기준일. 이 날짜 **이후** 입사자는 이번 평가 대상에서 자동으로
   * 빠진다(예: 2026-06-01을 넣으면 6월 이후 입사자 제외). 사람마다 손으로
   * 넣고 빼는 대신 규칙 한 줄로 두는 이유는, 조직도에 새 입사자가 들어올
   * 때마다 누가 명단을 다시 손보지 않아도 알아서 맞기 때문이다.
   * 개별 판단이 필요하면 GoalCycleTarget 행으로 덮어쓴다.
   */
  hireCutoff DateTime?

  /**
   * 목표 확정(마감) 시각. 찍히면 목표의 **내용**(제목·지표·가중치·담당·구조)은
   * 아무도 못 고치고, 진척(달성률)만 계속 올린다. 목표를 다 세운 뒤 슬그머니
   * 목표가 바뀌면 평가의 기준 자체가 흔들리기 때문이다.
   * 사이클 status가 CLOSED가 되면 진척까지 잠긴다(완전 읽기 전용).
   */
  goalsLockedAt   DateTime?
  goalsLockedById String?
  goalsLockedBy   User?     @relation("GoalCycleLockedBy", fields: [goalsLockedById], references: [id])

  /**
   * 목표를 빌려오는 사이클. 같은 해 목표 한 벌을 여러 평가가 나눠 볼 때 쓴다 —
   * "2026년 상반기"와 "2026년 최종평가"는 "2026년 목표설정"의 목표를 그대로
   * 보고, 목표를 각자 한 벌씩 들고 있지 않는다.
   * 복사가 아니라 참조다. 복사하면 어느 쪽이 진짜인지가 생기고, 한쪽에서 목표를
   * 고치면 다른 쪽과 어긋난다. 여기서는 화면만 여러 개고 목표는 한 벌이다.
   * 연도가 바뀔 때는 참조가 아니라 복사가 맞다(copyGoalsFromCycle).
   * 한 단계만 허용한다 — 빌려온 사이클을 또 빌려주면 어디가 원본인지 따라가기
   * 어려워진다.
   */
  sourceCycleId String?
  sourceCycle   GoalCycle?  @relation("GoalCycleShare", fields: [sourceCycleId], references: [id])
  sharedBy      GoalCycle[] @relation("GoalCycleShare")

  createdAt DateTime @default(now())

  goals       Goal[]
  targets     GoalCycleTarget[]
  sheetInfos  GoalSheetInfo[]
  checkpoints GoalCheckpoint[]

  @@index([year])
}

/**
 * 평가 시점 스냅샷. "2026년 상반기 평가"처럼 한 사이클 안에서 성적을 끊어
 * 읽어야 할 때, 그 순간의 달성률을 얼려 둔다.
 * 상반기 평가를 하겠다고 목표를 통째로 복사해 새 사이클을 만들면 같은 목표가
 * 두 벌이 되고, 어느 쪽이 진짜인지가 생긴다. 목표는 한 벌로 두고 시점만
 * 남기면 하반기에 달성률이 더 올라가도 상반기 성적은 흔들리지 않는다.
 */
model GoalCheckpoint {
  id      String    @id @default(cuid())
  cycleId String
  cycle   GoalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  /**
   * 예: "2026년 상반기 평가".
   */
  name    String
  takenAt DateTime  @default(now())
  note    String?

  createdById String
  createdBy   User   @relation("GoalCheckpointCreator", fields: [createdById], references: [id])

  entries GoalCheckpointEntry[]

  @@index([cycleId, takenAt])
}

/**
 * 스냅샷에 찍힌 목표 한 건의 그 시점 성적.
 */
model GoalCheckpointEntry {
  id           String         @id @default(cuid())
  checkpointId String
  checkpoint   GoalCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  goalId       String
  goal         Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)

  level    GoalLevel
  /**
   * 그 시점의 달성률 — 하위가 있으면 굴려 올린 값이다.
   */
  progress Int
  status   GoalStatus
  /**
   * 그 시점에 집계에서 빠져 있었는지(개별 제외 또는 평가대상 제외).
   */
  excluded Boolean    @default(false)

  @@unique([checkpointId, goalId])
  @@index([goalId])
}

/**
 * 목표 한 건. parentId로 상위 목표에 연결해서 전사 → 책임 → 팀 → 개인으로
 * 내려가는 정렬(cascade)을 만든다. 진척률은 하위 목표가 있으면 가중치
 * 기준으로 굴려 올리고(rollup), 없으면 progress 입력값을 그대로 쓴다.
 */
model Goal {
  id      String    @id @default(cuid())
  cycleId String
  cycle   GoalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  level   GoalLevel

  parentId String?
  parent   Goal?   @relation("GoalCascade", fields: [parentId], references: [id])
  children Goal[]  @relation("GoalCascade")

  title       String
  description String?

  /**
   * 책임목표가 속한 부문(책임) 이름. User.division / Team.division과 같은 값.
   */
  division String?
  /**
   * 팀목표가 걸린 팀.
   */
  teamId   String?
  team     Team?   @relation(fields: [teamId], references: [id])
  /**
   * 개인목표 담당자. 팀·책임 목표에서는 책임자(팀장·책임)를 가리킨다.
   */
  ownerId  String?
  owner    User?   @relation("GoalOwner", fields: [ownerId], references: [id])

  /**
   * 같은 부모 아래 형제 목표들 사이의 가중치(%). 진척 롤업에 쓴다.
   */
  weight Float @default(0)

  /**
   * "기타" 묶음인지. 위 층의 어느 목표에도 딱 붙지 않는 일을 담아 두는 자리다.
   * 이런 목표를 상위 없이 두면 아무리 달성해도 전사 달성률이 안 움직인다 —
   * 그래서 층마다 기타 한 칸을 두고 거기에 매단다. 등록할 때 상위 목표로
   * 「기타」를 고르면 필요한 만큼 자동으로 만들어진다(전사 기타 → 책임 기타 →
   * 팀 기타). 이름만 "기타"인 보통 목표와 구분하려고 플래그로 표시한다.
   */
  isOther Boolean @default(false)

  /**
   * 측정지표와 목표수준 — 서술형으로 받는다(예: "신규 거래처 20개").
   */
  metric       String?
  targetValue  String?
  currentValue String?

  /**
   * 평가척도. 사내 "팀 목표 설정" 양식의 S(110)~D(70) 다섯 칸을 그대로 받는다.
   * 점수가 아니라 **그 등급이 되려면 어디까지 해야 하는지를 서술로** 적는 칸이다
   * (예: S = "3천만원 이상 절감", C = "천만원 미만~백만원 이상 절감"). 목표를
   * 세울 때 등급 기준을 같이 못박아 둬야, 연말에 "이 정도면 A인가 B인가"를
   * 사람마다 다르게 읽는 일이 없다.
   */
  scaleS String?
  scaleA String?
  scaleB String?
  scaleC String?
  scaleD String?

  /**
   * 산출식/방안 — 이 지표를 무엇으로 재는지(예: "= 절감액", "= 만족도Survey").
   */
  formula String?

  /**
   * 목표 유형. 사내 "개인목표 설정" 양식에서 목표 앞에 붙는 괄호 —
   * (업무목표) / (개선목표) / (자기계발목표).
   * 세 가지를 섞어 세우게 하려고 두는 칸이다. 유형을 안 적게 하면 개인목표가
   * 전부 (업무목표)로만 채워져서, 개선과 자기계발이 목표 설정 단계에서 아예
   * 빠진다.
   */
  /// 상반기 / 하반기. 팀·개인 목표를 반기로 갈라 세우고 목록도 그렇게 묶는다.
  half String?

  goalType String?

  /**
   * Key Results(핵심결과). 줄바꿈 한 줄이 ① ② ③ 한 항목이다.
   * 항목마다 별도 행으로 두지 않는 이유는, 양식에서도 이것들이 달성률을 따로
   * 매기는 대상이 아니라 "목표를 무엇으로 봤다고 할지"를 적어 두는 목록이기
   * 때문이다. 나중에 항목별 진척을 재게 되면 그때 행으로 쪼갠다.
   */
  keyResults String?

  progress Int        @default(0)
  status   GoalStatus @default(ACTIVE)

  /**
   * 그 단계의 평가 — 사내 「개인목표 평가(상반기)」 표를 그대로 옮긴 칸들이다.
   * 본인이 자기 점수와 사유를 적고, 1차 평가자(팀장)가 그 아래 칸을 적는다.
   * 목표 행에 같이 두는 이유는, 마감할 때 단계마다 목표를 한 벌씩 복사해 갖기
   * 때문이다(`handOffToNextPhase`). 중간평가의 목표 행에 적힌 점수는 상반기
   * 평가이고, 최종평가 행에 적힌 것은 하반기 평가다 — 한 행이 두 학기를
   * 겸하지 않으므로 칸을 반기마다 따로 둘 필요가 없다.
   */
  selfScore   Int?
  selfComment String?

  /**
   * 1차 평가자가 매긴 값. **적혀 있으면 이것이 그 목표의 달성률·점수다.**
   * 피평가자가 적은 값(progress·selfScore)은 «본인은 이렇게 봤다»는 기록으로
   * 남고, 위로 굴러 올라가는 숫자는 평가자 것이 된다(`effectiveProgress`).
   */
  firstProgress Int?
  firstScore    Int?
  firstComment  String?

  /**
   * 1차 평가자가 «평가완료»를 누른 시각. 찍히면 그 단계의 평가가 끝났다는
   * 뜻이고, 목록에서 붉게 «완료»로 읽힌다. 되돌릴 수 있게 시각만 남긴다 —
   * 상태 값을 따로 두면 «완료인데 시각이 없는» 줄이 생긴다.
   */
  evalDoneAt   DateTime?
  evalDoneById String?

  /**
   * 집계 제외. 담당자가 퇴사하거나 다른 부서로 옮겨서 이 목표를 더는 그 조직의
   * 성과로 보기 어려울 때 켠다. 켜진 목표는 상위 목표 달성률 계산에서 빠지고,
   * 완료·지연 건수에도 잡히지 않는다. 목표 자체는 남겨둬야 나중에 왜 빠졌는지
   * 추적할 수 있어서 삭제 대신 이 플래그를 쓴다.
   */
  excluded      Boolean @default(false)
  excludeReason String?

  /**
   * 합의 단계. 개인목표에만 의미가 있다 — 전사·책임·팀 목표는 관리자·팀장이
   * 직접 세우는 값이라 합의 대상이 아니다.
   */
  agreementStatus GoalAgreementStatus @default(DRAFT)
  /**
   * 팀장이 되돌리며 남긴 사유, 또는 승인하며 남긴 메모.
   */
  agreementNote   String?
  agreedAt        DateTime?
  agreedById      String?
  agreedBy        User?               @relation("GoalAgreedBy", fields: [agreedById], references: [id])
  dueDate         DateTime?
  sortOrder       Int                 @default(0)

  createdById String
  createdBy   User     @relation("GoalCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checkIns          GoalCheckIn[]
  checkpointEntries GoalCheckpointEntry[]

  @@index([cycleId, level])
  @@index([parentId])
  @@index([teamId])
  @@index([ownerId])
}

/**
 * 진척 업데이트 이력. 언제 몇 %로 올렸고 무슨 근거였는지 남긴다.
 */
model GoalCheckIn {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  progress  Int
  note      String?
  authorId  String
  author    User     @relation("GoalCheckInAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([goalId, createdAt])
}

/**
 * 평가대상자. 사이클마다 "이 사람을 이번 목표관리에 넣는지"를 남긴다.
 * 행이 없으면 대상이다 — 재직 중인 사람은 기본적으로 전원 대상이고, 빼야 할
 * 사람만 included=false 로 행을 만든다. 그래야 입사자가 들어올 때마다 누가
 * 명단에 넣어주지 않아도 자동으로 대상에 잡힌다.
 * 제외로 바꾸면 그 사람이 이 사이클에서 가진 목표의 Goal.excluded 도 같이
 * 켜서 상위 달성률 집계에서 빠지게 한다 — 명단과 집계가 따로 놀면 "명단에서
 * 뺐는데 달성률은 그대로"가 된다.
 */
/**
 * 개인목표 설정 양식의 «1. 기본사항» 중 **사람이 직접 적는 칸**.
 * 인사카드(User)와 잇지 않는다 — 담당업무는 «인사 기획/보상평가»처럼 그 해
 * 자기가 무엇을 맡았는지 본인이 적는 문장이라, 인사 정보로 관리하면 매번
 * 인사팀을 거쳐야 한다. 평가대상 여부를 담는 GoalCycleTarget에 얹지 않은
 * 이유도 분명하다 — 그 표에 줄이 생기면 «손으로 정한 대상»으로 읽혀서
 * 입사일 기준(hireCutoff)을 덮어써 버린다.
 * 사이클마다 한 줄. 중간평가·최종평가는 목표를 빌려 쓰므로 원본
 * 사이클(sourceCycleId ?? id)에 저장해서 세 단계가 같은 값을 본다.
 */
model GoalSheetInfo {
  id      String    @id @default(cuid())
  cycleId String
  cycle   GoalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation("GoalSheetInfoUser", fields: [userId], references: [id], onDelete: Cascade)

  /// 담당업무 — 서술로 적는다(예: "인사 기획/보상평가").
  duty String?

  updatedAt DateTime @updatedAt

  @@unique([cycleId, userId])
}

model GoalCycleTarget {
  id      String    @id @default(cuid())
  cycleId String
  cycle   GoalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation("GoalCycleTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  included Boolean @default(true)
  /**
   * 제외 사유(퇴사, 부서이동, 휴직 등). 화면과 집계 제외 사유에 같이 쓴다.
   */
  reason   String?

  setById   String?
  setBy     User?    @relation("GoalCycleTargetSetter", fields: [setById], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([cycleId, userId])
  @@index([cycleId, included])
}

/**
 * 역량평가 한 벌 — **한 사람의 한 해**다.
 * 목표(GoalCycle)에 매달지 않는다. 역량평가는 «목표를 몇 % 했나»가 아니라 «어떤
 * 역량을 어느 수준으로 갖췄나»라서 목표설정·중간평가·최종평가로 갈리지 않고, 한
 * 해에 한 번 매긴다. 그래서 묶는 열쇠도 연도 하나다.
 * 문항 자체는 여기 담지 않는다(`src/lib/competency.ts`). 핵심가치 다섯 줄은 회사가
 * 해마다 같게 쓰고, 직무역량 다섯 줄은 직무마다 다른데 — 둘 다 인사팀이 정해서
 * 내려주는 양식이라 사람이 화면에서 만들 것이 아니다. 점수만 여기 남는다.
 */
model CompetencyReview {
  id     String @id @default(cuid())
  year   Int
  /**
   * 피평가자.
   */
  userId String
  user   User   @relation("CompetencyReviewee", fields: [userId], references: [id], onDelete: Cascade)

  /**
   * 양식 맨 아래의 「전체 코멘트」 — 팀장평가자만 적는다.
   * 문항별 점수로는 «왜 이 점수인지»가 남지 않는다. 사내 양식이 이 칸을 따로
   * 둔 이유가 그것이다(«평가 부여에 대한 추가적인 설명이나 격려/감사/교정 등
   * 정성적인 피드백»). 점수는 열 칸으로 흩어지지만 이 말은 한 덩어리라, 문항이
   * 아니라 평가 한 벌에 붙인다.
   */
  leadComment String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  competencyScores CompetencyScore[]

  @@unique([year, userId])
  @@index([year])
}

/**
 * 문항 한 줄의 자기평가·팀장평가 점수. 둘 다 1~5 정수이고, 아직 안 적었으면
 * null이다 — 0으로 두면 «부족(1)보다 낮은 점수»가 생기고 평균이 내려간다.
 */
model CompetencyScore {
  id       String           @id @default(cuid())
  reviewId String
  review   CompetencyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  /**
   * 문항의 **열쇠**(`CompetencyFormItem.key`). 문항 줄과 외래키로 묶지 않는다 —
   * 이 앱은 기동할 때 `prisma db push`를 돌리므로, 이미 점수가 들어 있는 표에
   * 필수 외래키를 새로 걸면 그 순간 배포가 멈춘다. 그리고 열쇠로 두면 해를
   * 넘겨도 같은 문항의 점수를 나란히 놓고 볼 수 있다.
   * 열쇠는 한 해 안에서 겹치지 않게 «갈래.직무.항목» 꼴로 짓는다.
   */
  itemKey  String

  selfScore Int?
  leadScore Int?
  /**
   * 팀장평가를 적은 사람. 조직도가 바뀌어도 «누가 적었나»는 남아야 한다.
   */
  leadById  String?
  leadBy    User?   @relation("CompetencyLeadRater", fields: [leadById], references: [id])

  updatedAt            DateTime            @updatedAt
  competencyFormItem   CompetencyFormItem? @relation(fields: [competencyFormItemId], references: [id])
  competencyFormItemId String?

  @@unique([reviewId, itemKey])
}

// --- 역량평가 양식(연도판) --------------------------------------------------

enum CompetencyFormStatus {
  /**
   * 작성 중 — 인사팀이 문항을 고칠 수 있다.
   */
  DRAFT
  /**
   * 평가 중 — 문항이 잠기고 점수를 받는다.
   */
  OPEN
  /**
   * 종료.
   */
  CLOSED
}

enum CompetencySetKind {
  /**
   * 핵심가치 · 팀원용.
   */
  CORE_STAFF
  /**
   * 핵심가치 · 팀장용.
   */
  CORE_LEADER
  /**
   * 직무역량 — 직무마다 한 벌. 담당이 받는다.
   */
  JOB
  /**
   * 리더십역량 — 전사 한 벌. 팀장이 직무역량 자리에 받는다.
   */
  LEADERSHIP
}

/**
 * 그 해의 역량평가 양식 한 벌.
 * 해마다 문항이 바뀌므로 연도로 판을 가른다. 2026년 문항을 고쳐도 2025년에 매긴
 * 점수는 2025년 문항에 그대로 붙어 있다 — 판을 가르지 않으면 문항을 손보는 순간
 * 지난해 평균이 «무엇에 대한 점수인지» 알 수 없게 된다.
 * 평가를 시작(OPEN)하면 문항이 잠긴다. 평가 도중에 문항이 바뀌면 먼저 제출한
 * 사람과 나중 사람이 다른 양식으로 평가받는다.
 */
model CompetencyForm {
  id     String               @id @default(cuid())
  year   Int                  @unique
  status CompetencyFormStatus @default(DRAFT)

  /**
   * 전체 마감 시각. 찍히면 자기평가·팀장평가를 **더 적을 수 없다** — 목표 쪽의
   * 「전체 마감」(`GoalCycle.goalsLockedAt`)과 같은 자리이고, 같은 고르개에
   * 「(마감)」으로 나란히 뜬다. 인사팀이 제출 기한을 닫는 동작이라 「마감 해제」로
   * 되돌릴 수 있고, status를 CLOSED(완료)로 닫는 것은 그 뒤의 별개 동작이다.
   */
  lockedAt   DateTime?
  lockedById String?
  lockedBy   User?     @relation("CompetencyFormLockedBy", fields: [lockedById], references: [id])

  sets        CompetencyItemSet[]
  assignments CompetencyJobAssignment[]
  targets     CompetencyTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * 문항 다섯 줄 묶음. 핵심가치는 팀원용·팀장용 두 벌, 직무역량은 직무마다 한 벌이다.
 * 직무역량을 «팀마다 한 벌»이 아니라 «직무마다 한 벌»로 두는 이유는 사내 양식이
 * 그렇게 생겼기 때문이다 — 관리팀 하나에 환경안전·일반·출고 세 직무가 있고,
 * 지점 열한 곳은 한 벌을 함께 쓴다. 팀에 매어 두면 둘 다 표현할 수 없다.
 */
model CompetencyItemSet {
  id     String            @id @default(cuid())
  formId String
  form   CompetencyForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  kind   CompetencySetKind
  /**
   * 「인사팀」·「지점」처럼 직무 이름. 핵심가치는 kind가 이미 말해 주므로 표시용이다.
   */
  name   String

  sortOrder Int @default(0)

  items       CompetencyFormItem[]
  assignments CompetencyJobAssignment[]

  @@unique([formId, kind, name])
  @@index([formId, kind])
}

/**
 * 문항 한 줄 — 영역 · 질문. 묶음마다 다섯 줄이다.
 */
model CompetencyFormItem {
  id    String            @id @default(cuid())
  setId String
  set   CompetencyItemSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  /**
   * 해를 넘겨도 이어지는 열쇠. 연도판을 복사할 때 그대로 옮기므로, 2025년과
   * 2026년의 같은 문항을 나란히 놓고 볼 수 있다.
   */
  key   String

  area     String
  question String

  sortOrder Int @default(0)

  scores CompetencyScore[]

  @@unique([setId, key])
}

/**
 * 직무역량 묶음을 누구에게 씌울지.
 * 줄은 두 가지다 — **팀 기본값**(teamId)과 **사람 예외**(userId). 팀에 하나를
 * 정해 두고 다른 직무인 사람만 따로 지정한다. 팀 하나에 직무가 하나인 대부분은
 * 팀 줄만 있으면 된다.
 * 한 팀·한 사람에 묶음은 하나뿐이다. 둘이 걸리면 직무역량이 열 문항이 된다.
 * 핵심가치는 여기 오지 않는다 — 직책(담당·팀장)이 정하므로 고를 것이 없다.
 */
model CompetencyJobAssignment {
  id     String            @id @default(cuid())
  formId String
  form   CompetencyForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  setId  String
  set    CompetencyItemSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation("CompetencyJobTeam", fields: [teamId], references: [id], onDelete: Cascade)
  userId String?
  user   User?   @relation("CompetencyJobUser", fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([formId, teamId])
  @@unique([formId, userId])
  @@index([formId])
}

/**
 * 역량평가에서 **빼는** 사람·팀.
 * 행이 없으면 대상이다 — 담당·팀장이면 기본적으로 전원 평가받고, 빼야 할 쪽만
 * 행을 만든다(`included = false`). 그래야 사람이 들어올 때마다 누가 명단에
 * 넣어주지 않아도 자동으로 대상에 잡힌다. 목표관리의 평가대상자 관리
 * (`GoalCycleTarget`)와 같은 방식이다.
 * 팀 줄 하나로 그 팀을 통째로 뺄 수 있다 — 비서실처럼 시스템 밖에서 따로
 * 처리하는 조직을 한 줄로 정리한다.
 */
model CompetencyTarget {
  id     String         @id @default(cuid())
  formId String
  form   CompetencyForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation("CompetencyTargetTeam", fields: [teamId], references: [id], onDelete: Cascade)
  userId String?
  user   User?   @relation("CompetencyTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  included Boolean @default(true)
  /**
   * 왜 뺐는지. 화면에 그대로 적어 준다 — 이유 없이 빠진 사람이 남지 않게.
   */
  reason   String?

  updatedAt DateTime @updatedAt

  @@unique([formId, teamId])
  @@unique([formId, userId])
  @@index([formId, included])
}


/**
 * 조직등급별 개인등급 분포표 한 줄 — 「조직이 A면 개인은 S 30% · A 60% · B 5% · C 5%」.
 *
 * 우리 회사 인사평가는 **상대평가**다. 종합점수가 몇 점이냐로 등급이 정해지지
 * 않고, 업무단위 안에서 몇 등이냐와 그 업무단위에 몇 자리가 있느냐로 정해진다.
 * 그 «몇 자리»를 적어 두는 표가 이것이다.
 *
 * 표를 코드에 박지 않고 DB에 두는 이유는 해마다 바뀌기 때문이다 — 회사 사정에
 * 따라 S 자리를 줄이는 해가 있고, 그때마다 개발자를 찾아오게 둘 수 없다.
 *
 * 배분율은 JSON 한 칸에 담는다(`{"S":30,"A+":0,"A":60,"B":5,"C":5}`). 등급마다
 * 칸을 따로 두면 등급을 하나 더 만들 때 스키마를 고쳐야 하고, 이 값은 늘 «다섯
 * 개를 한 덩어리로» 읽고 쓴다(합이 100이어야 하므로 한 칸만 보는 일이 없다).
 * 사내 목표 양식의 등급 기준(`TemplateItem.gradeCriteria`)도 같은 방식이다.
 */
model GradeQuota {
  id       String @id @default(cuid())
  year     Int
  /**
   * 조직(업무단위)의 등급 — S · A+ · A · B · C.
   */
  orgGrade String
  /**
   * 개인등급별 배분율(%)을 담은 JSON. 합이 100이 아니면 화면이 경고한다.
   */
  ratios   String

  updatedAt DateTime @updatedAt

  @@unique([year, orgGrade])
}

/**
 * 그 해 업무단위 하나에 매겨진 조직등급.
 *
 * 업무단위는 사람·팀에 이미 적혀 있는 값(`User.businessUnit` · `Team.businessUnit`)을
 * 쓴다 — 영업고객관리 · 재무경영관리 · 연구생산 · 제품사업. 따로 조직표를 만들지
 * 않는 이유는 그러면 조직이 바뀔 때마다 두 곳을 맞춰야 하기 때문이다.
 *
 * 등급이 비어 있으면(`orgGrade = null`) 그 업무단위는 아직 등급을 배분하지 않는다
 * — 몇 자리가 있는지 모르는 채로 순위만 보고 등급을 매기지 않는다.
 */
model GradeUnitPlan {
  id   String @id @default(cuid())
  year Int
  /**
   * 등급을 매기는 **묶음 열쇠** — 그 라인 운영책임의 userId다.
   *
   * 예전에는 업무단위 이름(제품사업·연구생산…)이었다. 이름이 비어 있거나 팀마다
   * 다르게 적혀 있으면 사람들이 「업무단위 미지정」 한 덩어리로 몰려, 상대평가의
   * 묶음이 뜻을 잃었다. 실제로 굴러가는 단위는 «누가 그 라인을 맡는가»다.
   *
   * 칸 이름(`businessUnit`)은 그대로 둔다 — 이름을 바꾸면 `db push`가 칸을 지웠다
   * 다시 만들어, 이미 골라 둔 조직등급이 말없이 사라진다.
   */
  unitKey  String  @map("businessUnit")
  orgGrade String?

  updatedAt DateTime @updatedAt

  @@unique([year, unitKey])
}

/**
 * 인사팀이 **직접 확정한** 개인 등급. 계산값을 덮어쓴다.
 *
 * 정원을 사람 수로 나누면 소수가 남는다(스물한 명에게 5%면 1.05자리). 경계에
 * 걸린 사람과 동점자는 표만 보고는 가를 수 없어서, 그런 자리는 화면이 「반올림
 * 확인」으로 표시하고 인사팀이 직접 정한다 — 이 줄이 그 결정이다.
 *
 * 줄이 없으면 계산값을 쓴다. 덮어쓴 줄만 남기므로, 사람이 들어오고 나가도 명단을
 * 따로 관리할 필요가 없다.
 */
/**
 * 운영(책임) 가산점 — 종합점수에 더하거나 빼는 조정 한 줄.
 *
 * 성과 60% + 역량 40%는 목표와 문항에서 기계적으로 나오는 값이라, 그 해에 어느
 * 본부가 특별히 무엇을 해냈는지(또는 어긋났는지)를 담지 못한다. 운영책임이
 * 그것을 ±점으로 얹는 자리다. 점수 자체를 손대지 않고 **따로 한 줄로** 두는
 * 이유는 근거가 남아야 하기 때문이다 — 성과점수를 96에서 98로 고쳐 두면 왜
 * 2점이 붙었는지 아무도 모른다.
 *
 * 등급은 이 가산점까지 더한 최종점수로 매긴다(HR REPORT 화면이 한 자리다).
 */
model GradeBonus {
  id     String @id @default(cuid())
  year   Int
  userId String
  user   User   @relation("GradeBonusUser", fields: [userId], references: [id], onDelete: Cascade)

  /** ± 점. 종합점수(100점 자리)에 그대로 더한다. */
  points Float
  note   String?

  setById String?
  setBy   User?   @relation("GradeBonusSetBy", fields: [setById], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([year, userId])
  @@index([year])
}

model FinalGrade {
  id     String @id @default(cuid())
  year   Int
  userId String
  user   User   @relation("FinalGradeUser", fields: [userId], references: [id], onDelete: Cascade)

  grade String
  /**
   * 왜 계산값과 다르게 정했는지. 등급은 사람의 보상으로 이어지므로 근거를 남긴다.
   */
  note  String?

  fixedById String?
  fixedBy   User?   @relation("FinalGradeFixedBy", fields: [fixedById], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([year, userId])
  @@index([year])
}

/**
 * 그 해 평가의 **끝 두 칸** — 인사팀이 결과를 직원에게 배포한 시점과, 그 해를
 * 마감한 시점.
 *
 * 등급은 상대평가라 «남의 점수»가 다 들어와야 정해진다. 그래서 마감 직후에는
 * 표대로 계산된 등급이 화면에 뜨긴 뜨는데, 인사팀이 반올림 경계를 손으로
 * 조정하기 전의 값이다 — 그것을 직원이 먼저 보면 나중에 «등급이 바뀌었다»가
 * 된다. 그래서 결과지의 최종등급은 **배포를 누른 뒤**에만 직원에게 보인다.
 *
 * 마감(`closedAt`)은 그다음 칸이다. 배포까지 끝난 해를 «닫는다»는 표시이고,
 * 진행 띠의 「종료」가 이 값으로 켜진다.
 *
 * 되돌릴 수 있게 시각만 남긴다 — 상태 값을 따로 두면 «배포인데 시각이 없는»
 * 줄이 생긴다(목표 마감·역량평가 마감과 같은 방식).
 */
model EvalYearRelease {
  id   String @id @default(cuid())
  year Int    @unique

  releasedAt   DateTime?
  releasedById String?
  closedAt     DateTime?
  closedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
